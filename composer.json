{
    "name": "student/ci-cd-lab",
    "description": "Лабораторна робота 1. CI для PHP: Calculator, PHPUnit і Pint.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "test": "phpunit tests",
        "pint": "pint",
        "pint:test": "pint --test"
    },
    "config": {
        "sort-packages": true
    }
}
